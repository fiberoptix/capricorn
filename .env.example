# Capricorn Environment Configuration
# Copy this file to .env and customize as needed

# =========================
# Database Configuration
# =========================
POSTGRES_USER=capricorn
POSTGRES_PASSWORD=REDACTED_DB_PASSWORD
POSTGRES_DB=capricorn_db

# =========================
# Application Settings
# =========================
BUILD_NUMBER=1

# =========================
# Optional: Override defaults
# =========================
# DATABASE_URL=postgresql://capricorn:REDACTED_DB_PASSWORD@postgres:5432/capricorn_db
# REDIS_URL=redis://redis:6379/0
# SECRET_KEY=your-secret-key-change-in-production
